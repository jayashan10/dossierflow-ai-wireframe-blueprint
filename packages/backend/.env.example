# Backend Configuration

# Server Port
PORT=4000

# Anthropic Claude Agent SDK Authentication
# API key is required unless you rely on a proxy that injects auth headers for you.
# Docs: https://docs.claude.com/en/api/agent-sdk/overview
ANTHROPIC_API_KEY=sk-ant-...

# Optional: Override the default Anthropic endpoint (e.g., when routing through AgentRouter or LiteLLM).
# If you set a custom base URL you must include the trailing slash expected by that service.
# Example reference: https://docs.agentrouter.org/en/start.html
# ANTHROPIC_BASE_URL=https://agentrouter.org/

# Optional: Token used by some proxy services in the Authorization header.
# When set, the SDK treats it as the Bearer token value. See https://docs.claude.com/en/docs/claude-code/settings
# ANTHROPIC_AUTH_TOKEN=sk-proxy-...

# Optional: Provide additional headers for compatible gateways (format: "Header-Name: Value").
# ANTHROPIC_CUSTOM_HEADERS=X-Forwarded-For: 203.0.113.10

# Optional: Third-party hosting toggles (one of these may be required instead of ANTHROPIC_API_KEY).
# CLAUDE_CODE_USE_BEDROCK=0
# CLAUDE_CODE_USE_VERTEX=0

# Feature Flags
ENABLE_CLAUDE_AGENT=true
USE_SEMTOOLS=false

# Semtools Configuration (required if USE_SEMTOOLS=true)
# Get your API key from: https://cloud.llamaindex.ai/
# LLAMA_CLOUD_API_KEY=llx-...
SEMTOOLS_WORKSPACE=dossierflow

# Agent Configuration
AGENT_MAX_TURNS=5
AGENT_ENABLE_TOOLS=true

# Storage Directories (Optional - defaults to ../data and ../templates)
# SOURCE_ROOT=./data
# TEMPLATE_ROOT=./templates

# Agent Workspace (Optional - for sandboxed tool execution)
# AGENT_WORKSPACE=./tmp/agents
