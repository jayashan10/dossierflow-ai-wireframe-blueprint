# Backend Configuration

# Server Port
PORT=4000

# OpenAI Codex Authentication (OPTIONAL)
# By default, the app uses Codex CLI authentication (npx codex login)
# Only set this if you want to use API key authentication instead
# Get your API key from: https://platform.openai.com/api-keys
# CODEX_API_KEY=sk-proj-...

# Storage Directories (Optional - defaults to ../data and ../templates)
# SOURCE_ROOT=./data
# TEMPLATE_ROOT=./templates
